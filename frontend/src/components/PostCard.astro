---
import PostVisual from "./PostVisual.astro";
import { formatDate, postCategory, type Post } from "../lib/site";
interface Props { post: Post; compact?: boolean; }
const { post, compact = false } = Astro.props;
const category = postCategory(post);
---
<article class:list={["post-card", { compact }]}>
  <a class="post-card-media" href={`/artikel/${post.slug}/`} aria-label={`Baca ${post.title}`}>
    <PostVisual image={post.featuredImage} alt={post.featuredAlt} category={category.name} />
  </a>
  <div class="post-card-body">
    <h3><a href={`/artikel/${post.slug}/`}>{post.title}</a></h3>
    {!compact && <p>{post.excerpt}</p>}
    <div class="meta">{formatDate(post.date)} · {post.readingMinutes} menit baca</div>
  </div>
</article>
