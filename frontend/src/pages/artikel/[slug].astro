---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostVisual from "../../components/PostVisual.astro";
import { posts, formatDate, postCategory, type Post } from "../../lib/site";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post; }
const { post } = Astro.props;
const category = postCategory(post);
const related = posts.filter((candidate) => candidate.id !== post.id && candidate.categories.some((item) => item.slug === category.slug)).slice(0, 3);
---
<BaseLayout title={`${post.title} | DGworld`} description={post.excerpt} image={post.featuredImage}>
  <main id="main-content" class="container article-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href={`/kategori/${category.slug}/`}>{category.name}</a></nav>
    <article data-pagefind-body>
      <header class="article-header">
        <span class="badge">{category.name}</span>
        <h1 data-pagefind-meta="title">{post.title}</h1>
        <p>Oleh {post.author} · {formatDate(post.date)} · {post.readingMinutes} menit baca</p>
      </header>
      <div class="article-image"><PostVisual image={post.featuredImage} alt={post.featuredAlt} category={category.name} eager /></div>
      <div class="article-content" set:html={post.content} />
    </article>
    {related.length > 0 && <aside class="related"><h2>Lanjutkan membaca</h2>{related.map((item) => <a href={`/artikel/${item.slug}/`}>{item.title}<span>→</span></a>)}</aside>}
  </main>
</BaseLayout>
