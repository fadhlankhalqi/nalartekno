---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import PostVisual from "../components/PostVisual.astro";
import { visibleCategories, formatDate, postCategory } from "../lib/site";
import { getSiteData, setContentCacheHeaders } from "../lib/wordpress";

setContentCacheHeaders(Astro.response);
const { posts, categories } = await getSiteData();
const categoryList = visibleCategories(categories);
const [featured, ...rest] = posts;
const sidePosts = rest.slice(0, 2);
const categoryStyles = ["basic", "intermediate", "advanced", "expert"];
---
<BaseLayout>
  <main id="main-content" class="container">
    <section class="learning-hero">
      <div>
        <p class="hero-kicker">Belajar dan mengikuti perkembangan teknologi</p>
        <h1>Pahami teknologi.<br />Temukan topikmu.</h1>
        <p>Baca berita, panduan, dan pembelajaran teknologi yang dikelola langsung melalui WordPress NalarTekno.</p>
        <div class="hero-actions"><a class="primary-button" href="#terbaru">Baca artikel terbaru</a><a class="secondary-button" href="#kategori">Jelajahi kategori</a></div>
      </div>
      <ol class="level-map">
        {categoryList.slice(0, 6).map((category, index) => <li class={categoryStyles[index % categoryStyles.length]}><span>{String(index + 1).padStart(2, "0")}</span><strong>{category.name}</strong></li>)}
      </ol>
    </section>

    {featured && (
      <>
        <div id="terbaru" class="ticker"><strong>Terbaru</strong><a href={`/artikel/${featured.slug}/`}>{featured.title}</a><time>{formatDate(featured.date)}</time></div>
        <section class="featured-grid" aria-label="Artikel pilihan">
          <article class="featured-post">
            <PostVisual image={featured.featuredImage} alt={featured.featuredAlt} category={postCategory(featured).name} eager />
            <div><span class="badge">{postCategory(featured).name}</span><h2><a href={`/artikel/${featured.slug}/`}>{featured.title}</a></h2><p>{formatDate(featured.date)} · {featured.readingMinutes} menit baca</p></div>
          </article>
          <div class="featured-side">{sidePosts.map((post) => <PostCard post={post} compact />)}</div>
        </section>
      </>
    )}

    <section id="kategori" class="content-section">
      <div class="section-heading"><h2>Jelajahi kategori</h2></div>
      <p class="section-intro">Kategori dikelola dari WordPress dan diperbarui otomatis setelah diterbitkan.</p>
      <div class="learning-levels">
        {categoryList.map((category, index) => {
          const categoryPosts = posts.filter((post) => post.categories.some((item) => item.id === category.id));
          return (
            <article class={`learning-level ${categoryStyles[index % categoryStyles.length]}`}>
              <div class="level-title"><span>{String(index + 1).padStart(2, "0")}</span><div><small>Kategori</small><h3>{category.name}</h3></div></div>
              <p>{category.description || `Artikel terbaru seputar ${category.name}.`}</p>
              <div class="level-count">{categoryPosts.length} artikel</div>
              <ol>{categoryPosts.slice(0, 5).map((post) => <li><a href={`/artikel/${post.slug}/`}>{post.title}</a></li>)}</ol>
              <a class="level-action" href={`/kategori/${category.slug}/`}>Lihat kategori {category.name} →</a>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
