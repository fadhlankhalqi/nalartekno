---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Cari Tutorial dan Berita | NalarTekno" description="Cari tutorial teknologi dan berita digital di NalarTekno.">
  <main id="main-content" class="container search-page">
    <header><h1>Cari di NalarTekno</h1><p>Temukan tutorial, berita, atau topik teknologi yang ingin Anda pelajari.</p></header>
    <div id="search"></div>
  </main>
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline type="module">
    import { PagefindUI } from "/pagefind/pagefind-ui.js";
    const params = new URLSearchParams(window.location.search);
    const query = params.get("q") || "";
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: "Contoh: HTML dasar",
        zero_results: "Tidak ada hasil untuk [SEARCH_TERM]. Coba kata kunci yang lebih umum."
      }
    });
    if (query) {
      const input = document.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
      if (input) {
        input.value = query;
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
    }
  </script>
</BaseLayout>
