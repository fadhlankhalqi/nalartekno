---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getSiteData, setContentCacheHeaders } from "../lib/wordpress";

setContentCacheHeaders(Astro.response);
const query = (Astro.url.searchParams.get("q") || "").trim();
const normalizedQuery = query.toLocaleLowerCase("id-ID");
const { posts } = await getSiteData();
const results = normalizedQuery
  ? posts.filter((post) =>
      [post.title, post.excerpt, post.content, ...post.categories.map((category) => category.name)]
        .join(" ")
        .toLocaleLowerCase("id-ID")
        .includes(normalizedQuery)
    )
  : [];
---
<BaseLayout title="Cari Artikel | NalarTekno" description="Cari berita dan pembelajaran teknologi di NalarTekno.">
  <main id="main-content" class="container search-page">
    <header>
      <h1>Cari di NalarTekno</h1>
      <p>Temukan berita, panduan, atau topik teknologi yang ingin Anda pelajari.</p>
      <form class="search-form" action="/cari/" role="search">
        <label class="sr-only" for="page-search">Kata kunci pencarian</label>
        <input id="page-search" name="q" type="search" value={query} placeholder="Contoh: kecerdasan buatan" required />
        <button class="primary-button" type="submit">Cari artikel</button>
      </form>
    </header>
    {query && (
      results.length
        ? <><p class="search-summary">{results.length} hasil untuk “{query}”</p><div class="archive-grid">{results.map((post) => <PostCard post={post} />)}</div></>
        : <div class="empty-state"><h2>Artikel tidak ditemukan</h2><p>Coba kata kunci yang lebih singkat atau gunakan nama kategori.</p></div>
    )}
  </main>
</BaseLayout>
