---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteData, setContentCacheHeaders } from "../lib/wordpress";

setContentCacheHeaders(Astro.response);
const { slug } = Astro.params;
const { pages } = await getSiteData();
const page = pages.find((candidate) => candidate.slug === slug);

if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite("/404/");
}
---
<BaseLayout title={`${page.title} | NalarTekno`}>
  <main id="main-content" class="container info-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><span>{page.title}</span></nav>
    <article><h1>{page.title}</h1><div class="article-content" set:html={page.content} /></article>
  </main>
</BaseLayout>
